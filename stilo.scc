:root {
    --color-primario: #0f172a;
    --color-secundario: #3b82f6;
    --color-acento: #38bdf8;
    --fondo-pagina: #f8fafc;
    --fondo-seccion: #ffffff;
    --texto-principal: #334155;
    --borde-color: #e2e8f0;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--fondo-pagina);
    color: var(--texto-principal);
    margin: 0;
    padding: 0;
}

.encabezado {
    background: linear-gradient(135deg, var(--color-primario), var(--color-secundario));
    color: white;
    text-align: center;
    padding: 2.5rem 1rem;
}

.encabezado h1 {
    margin: 0 0 0.5rem 0;
    font-size: 2.2rem;
}

.encabezado p {
    margin: 0.2rem 0;
    font-size: 1.1rem;
}

.encabezado .autor {
    margin-top: 0.8rem;
    font-size: 0.95rem;
    color: var(--color-acento);
}

.menu {
    background-color: var(--color-primario);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    padding: 0.8rem;
    position: sticky;
    top: 0;
    z-index: 100;
}

.menu a {
    color: white;
    text-decoration: none;
    padding: 0.5rem 1rem;
    margin: 0.2rem;
    border-radius: 4px;
    transition: background-color 0.2s;
}

.menu a:hover {
    background-color: var(--color-secundario);
}

.contenedor-grid {
    max-width: 1100px;
    margin: 2rem auto;
    padding: 0 1rem;
    display: grid;
    gap: 1.5rem;
}

.seccion {
    background-color: var(--fondo-seccion);
    border: 1px solid var(--borde-color);
    border-radius: 8px;
    padding: 1.5rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05);
}

.seccion h2 {
    color: var(--color-primario);
    border-bottom: 2px solid var(--color-secundario);
    padding-bottom: 0.5rem;
    margin-top: 0;
}

input, select, textarea, button {
    width: 100%;
    padding: 0.75rem;
    margin: 0.5rem 0 1rem 0;
    border: 1px solid var(--borde-color);
    border-radius: 4px;
    box-sizing: border-box;
    font-size: 1rem;
}

button {
    background-color: var(--color-secundario);
    color: white;
    border: none;
    cursor: pointer;
    font-weight: bold;
    transition: background-color 0.2s;
}

button:hover {
    background-color: #2563eb;
}

.boton-secundario {
    background-color: #64748b;
}

.boton-secundario:hover {
    background-color: #475569;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
}

th, td {
    border: 1px solid var(--borde-color);
    padding: 0.75rem;
    text-align: left;
}

th {
    background-color: var(--color-primario);
    color: white;
}

.tarjetas-flex {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.tarjeta {
    flex: 1;
    min-width: 250px;
    border: 1px solid var(--borde-color);
    padding: 1rem;
    border-radius: 6px;
    background-color: #fff;
}

.rejilla-demo {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-top: 1rem;
}

.celda {
    background-color: #e0f2fe;
    color: #0369a1;
    padding: 1rem;
    text-align: center;
    border-radius: 4px;
    font-weight: bold;
}

.imagen-principal {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 1rem 0;
}
